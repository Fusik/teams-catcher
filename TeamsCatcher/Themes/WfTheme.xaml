<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Uzupelnienie stylu WF BIM (Assets/WF) dla kontrolek, ktorych WF.Controls.xaml nie pokrywa:
        GroupBox, ListBox/ListBoxItem, ProgressBar, przycisk drugorzedny z hoverem.
        Laduje sie po AppTheme i WF.* - nadpisuje jasne style domyslne.
    -->

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource WF.Brush.Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource WF.Brush.Line}" />
        <Setter Property="Background" Value="{StaticResource WF.Brush.Navy700}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource WF.Brush.Head}" Padding="10,6"
                                    BorderBrush="{StaticResource WF.Brush.Rim}" BorderThickness="0,0,0,1">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  TextElement.Foreground="{StaticResource WF.Brush.Blue100}"
                                                  TextElement.FontFamily="{StaticResource WF.Font.Display}"
                                                  TextElement.FontWeight="SemiBold" />
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Listy rozwijane (ToggleButton + Popup): domyślny szablon WPF dawał przy hoverze jasne tło pod jasnym tekstem. -->
    <Style TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Head}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WF.Brush.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Blue700}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nagłówek tabeli w wąskim panelu: WF.DataGridHeader z mniejszym marginesem (10,8 ucinało tekst kolumn). -->
    <Style x:Key="App.DataGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WF.DataGridHeader}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,8,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource WF.Brush.Rim}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- nazwa wymagana przez WPF: bez niej treść zakładki jest niewidoczna dla czytników ekranu (UI Automation) -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource WF.Brush.Slate}" />
        <Setter Property="FontFamily" Value="{StaticResource WF.Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="14,6" Margin="0,0,2,-1">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Head}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WF.Brush.Blue500}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Navy700}" />
                            <Setter Property="Foreground" Value="{StaticResource WF.Brush.Blue100}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource WF.TextBox}">
        <Setter Property="SelectionBrush" Value="{StaticResource WF.Brush.Blue500}" />
        <Setter Property="CaretBrush" Value="{StaticResource WF.Brush.Cyan}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource WF.Brush.Mute}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="{StaticResource WF.Brush.Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource WF.Brush.Line}" />
        <Setter Property="Foreground" Value="{StaticResource WF.Brush.Blue500}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource WF.Brush.Field}" />
        <Setter Property="Foreground" Value="{StaticResource WF.Brush.Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource WF.Brush.Rim}" />
        <Setter Property="FontFamily" Value="{StaticResource WF.Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Head}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Blue700}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Przycisk drugorzedny z szablonem (domyslny szablon WPF zmienialby tlo na jasne przy hoverze). -->
    <Style x:Key="App.Button.Secondary" TargetType="Button" BasedOn="{StaticResource WF.Button.Secondary}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#662F7BFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value=".4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Przyciski paska tytulu (minimalizuj / maksymalizuj / zamknij) -->
    <Style x:Key="App.Button.Caption" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource WF.Brush.Mute}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Head}" />
                            <Setter Property="Foreground" Value="{StaticResource WF.Brush.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.Button.CaptionClose" TargetType="Button" BasedOn="{StaticResource App.Button.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Err}" />
                            <Setter Property="Foreground" Value="{StaticResource WF.Brush.Navy900}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Przycisk "kotwica" na pasku tytulu: okno zawsze na wierzchu (Window.Topmost) -->
    <Style x:Key="App.Toggle.CaptionPin" TargetType="ToggleButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource WF.Brush.Mute}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Head}" />
                            <Setter Property="Foreground" Value="{StaticResource WF.Brush.Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WF.Brush.Blue700}" />
                            <Setter Property="Foreground" Value="{StaticResource WF.Brush.Cyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- długie podpowiedzi (całe zdanie z transkrypcji w TO CLARIFY) zawijane zamiast jednej linii przez cały ekran -->
    <Style TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="520" />
        <Style.Resources>
            <Style TargetType="ContentPresenter">
                <Style.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </Style.Resources>
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
