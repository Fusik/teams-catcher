<Window x:Class="TeamsCatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeamsCatcher.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WF BIM – Teams Catcher" Height="900" Width="1320" MinHeight="600" MinWidth="1140"
        Icon="pack://application:,,,/Assets/WF/WF.TeamsCatcher.ico"
        Background="{StaticResource WF.Brush.Navy800}"
        Foreground="{StaticResource WF.Brush.Ink}"
        FontFamily="{StaticResource WF.Font.Body}" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WF.Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource WF.Brush.Slate}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,12,2" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WF.Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource WF.Brush.Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource WF.Brush.Rim}" BorderThickness="1">
    <DockPanel>
        <!-- Pasek tytułu -->
        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource WF.Brush.Navy900}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="pack://application:,,,/Assets/WF/WF.TeamsCatcher-48.png" Width="18" Height="18" Margin="0,0,8,0" />
                <TextBlock Text="WF BIM – Teams Catcher" FontSize="12" Foreground="{StaticResource WF.Brush.Mute}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <controls:WfIcon Kind="polacz" Width="14" Height="14" Margin="0,0,6,0" />
                <TextBlock FontFamily="{StaticResource WF.Font.Mono}" FontSize="11" Foreground="{StaticResource WF.Brush.Mute}"
                           Text="{Binding UserName, StringFormat=User: {0}}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton AutomationProperties.Name="Always on top" Style="{StaticResource App.Toggle.CaptionPin}" ToolTip="Always on top"
                              IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                    <Path Data="M3.5,0.5 H6.5 M4,0.5 V4 L2,6 H8 L6,4 V0.5 M5,6 V9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1" />
                </ToggleButton>
                <Button AutomationProperties.Name="Minimize" Style="{StaticResource App.Button.Caption}" Click="Minimize_Click" ToolTip="Minimize">
                    <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                </Button>
                <Button AutomationProperties.Name="Maximize or restore" Style="{StaticResource App.Button.Caption}" Click="MaxRestore_Click" ToolTip="Maximize / restore">
                    <Grid Width="10" Height="10">
                        <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                        <Path x:Name="RestoreIcon" Visibility="Collapsed" Data="M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Grid>
                </Button>
                <Button AutomationProperties.Name="Hide to tray" Style="{StaticResource App.Button.CaptionClose}" Click="Close_Click" ToolTip="Hide to tray (keeps running)">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Nagłówek: tytuł | Teams | akcje -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WF.Brush.Navy900}"
                BorderBrush="{StaticResource WF.Brush.Blue500}" BorderThickness="0,0,0,2" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/WF/WF.TeamsCatcher-48.png" Width="32" Height="32" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center" Background="Transparent">
                        <StackPanel.ToolTip>
                            <ToolTip MaxWidth="420">
                                <StackPanel>
                                    <TextBlock Text="How it works" FontFamily="{StaticResource WF.Font.Display}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock TextWrapping="Wrap" Text="Runs in the background (tray). When Microsoft Teams starts using the microphone (call or meeting), the app records only the Teams meeting window and only the Teams sound, plus your microphone as a separate track.&#10;&#10;When the call ends, the recording is saved as an MP4 and a 16 kHz mono WAV ready for transcription. Inform the other participants that the meeting is recorded." />
                                </StackPanel>
                            </ToolTip>
                        </StackPanel.ToolTip>
                        <TextBlock Text="TEAMS CATCHER" FontFamily="{StaticResource WF.Font.Display}" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource WF.Brush.Ink}" />
                        <TextBlock Text="WF | BIM  ·  Microsoft Teams" FontFamily="{StaticResource WF.Font.Mono}" FontSize="11"
                                   Foreground="{StaticResource WF.Brush.Slate}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,12,0" Padding="8,2"
                        Background="{StaticResource WF.Brush.Navy700}" BorderBrush="{StaticResource WF.Brush.Rim}" BorderThickness="1">
                    <DockPanel>
                        <controls:WfIcon DockPanel.Dock="Left" Kind="polacz" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource WF.Font.Mono}" FontSize="10" Foreground="{StaticResource WF.Brush.Slate}" Text="TEAMS" />
                            <TextBlock Text="{Binding TeamsStatus}" FontFamily="{StaticResource WF.Font.Display}" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource WF.Brush.Blue300}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Button AutomationProperties.Name="Recordings folder" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource App.Button.Secondary}"
                        Command="{Binding OpenOutputFolderCommand}" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <controls:WfIcon Kind="folder" />
                        <TextBlock Text="Recordings folder" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Panel boczny: notatka wybranego nagrania + analiza od nowa po objaśnieniu niejasnych słów -->
        <!-- Szerokość panelu NOTES zmieniana przeciągnięciem; minimum części głównej pilnuje, żeby ustawienia się nie rozjechały -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.3*" MinWidth="800" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"
                      ToolTip="Drag to resize the notes panel" />
        <GroupBox Grid.Column="2" Margin="0,8,8,8">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <controls:WfIcon Kind="plik" />
                    <TextBlock Text="NOTES" Margin="8,0,0,0" />
                </StackPanel>
            </GroupBox.Header>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedRecording.Name}" Style="{StaticResource Value}" Foreground="{StaticResource WF.Brush.Cyan}"
                           ToolTip="{Binding SelectedRecording.Folder}" Margin="0,0,0,6" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource WF.Button.Primary}" Padding="10,4" Command="{Binding RedoCommand}"
                            ToolTip="Save the explanations from TO CLARIFY to the knowledge base and analyse this recording again with that context (models' discussion, translation, notes; speech recognition is reused)">
                        <TextBlock Text="Redo after clarification" />
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource App.Button.Secondary}" Padding="10,4" Command="{Binding OpenNotesCommand}" ToolTip="Open the notes file">
                        <TextBlock Text="Open" />
                    </Button>
                </DockPanel>
                <TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" FontSize="12" Padding="8,6" Background="{StaticResource WF.Brush.Navy900}" />
            </DockPanel>
        </GroupBox>

        <Grid Grid.Column="0" Margin="8,8,2,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="0,0,0,10">
            <TabItem Header="TEAMS CALLS">
            <StackPanel>
            <!-- Status -->
            <GroupBox>
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:WfIcon Kind="walidacja" />
                        <TextBlock Text="STATUS" Margin="8,0,0,0" />
                    </StackPanel>
                </GroupBox.Header>
                <DockPanel>
                    <Button AutomationProperties.Name="{Binding ToggleText}" DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource WF.Button.Primary}"
                            Command="{Binding ToggleRecordingCommand}" FontSize="13" Padding="12,6" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <controls:WfIcon Kind="punkt" Stroke="White" DetailStroke="{StaticResource WF.Brush.Blue100}" />
                            <TextBlock Text="{Binding ToggleText}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="STATE" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Label}" Text="DURATION" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Value}" Text="{Binding Elapsed}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="WINDOW" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding WindowTitle}"
                                   Foreground="{StaticResource WF.Brush.Cyan}" ToolTip="{Binding WindowTitle}" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Text="FREE SPACE" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Value}" Text="{Binding FreeSpace}" />
                    </Grid>
                </DockPanel>
            </GroupBox>

            <!-- Ustawienia -->
            <GroupBox Margin="0">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:WfIcon Kind="ustawienia" />
                        <TextBlock Text="SETTINGS" Margin="8,0,0,0" />
                    </StackPanel>
                </GroupBox.Header>
                <StackPanel>
                    <DockPanel>
                        <Button AutomationProperties.Name="Browse" DockPanel.Dock="Right" Style="{StaticResource App.Button.Secondary}" Command="{Binding BrowseCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <controls:WfIcon Kind="folder" />
                                <TextBlock Text="Browse..." Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" ToolTip="Folder for recordings" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="GLOSSARY" Margin="0,0,8,0" />
                        <TextBox Text="{Binding TranscriptGlossary, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Names, companies and terms used in your meetings, comma-separated (e.g. Tekla, IFC, Kowalski). Helps Whisper spell them correctly." />
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding AutoRecord}" Content="Record Teams calls automatically" Margin="0,0,20,0" />
                        <CheckBox IsChecked="{Binding RecordMicrophone}" Content="Record my microphone" Margin="0,0,20,0" />
                        <CheckBox IsChecked="{Binding RecordVideo}" Content="Video" Margin="0,0,8,0"
                                  ToolTip="Record the Teams window. Off = audio only (meeting.mp4 with sound, still enough for the transcript)" />
                        <CheckBox IsChecked="{Binding AutoTranscribe}" Content="Transcript" Margin="0,0,8,0" />
                        <CheckBox IsChecked="{Binding LiveNotes}" Content="Live notes" Margin="0,0,8,0"
                                  ToolTip="Every 5 minutes of a call: transcript and a partial note (main point, assumptions, conclusions, remarks, agreements) in a tray popup. After the call the result is assembled from the parts - ready sooner." />
                        <CheckBox IsChecked="{Binding WriteNotes}" Content="Meeting notes" Margin="0,0,8,0"
                                  ToolTip="Summary, decisions, action items and open questions in Polish and English (local model in Ollama)" />
                        <CheckBox IsChecked="{Binding TranslateTranscript}" Content="Translate PL/EN" Margin="0,0,8,0"
                                  ToolTip="Detects the language of the conversation and adds a Polish / English translation (local model in Ollama)" />
                        <TextBlock Style="{StaticResource Label}" Text="OTHERS" Margin="0,0,6,0" />
                        <ToggleButton AutomationProperties.Name="Speakers on the Teams side" x:Name="SpeakersToggle" Padding="10,3" Margin="0,0,20,0" Foreground="{StaticResource WF.Brush.Blue100}" Background="#332F7BFF"
                                      BorderBrush="{StaticResource WF.Brush.Blue300}" ToolTip="Number of speakers on the Teams side (without you). Set it when you know it - the split is exact; auto guesses from voice similarity.">
                            <TextBlock Text="{Binding Speakers, StringFormat={}{0} ▾}" FontFamily="{StaticResource WF.Font.Mono}" FontSize="12" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=SpeakersToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SpeakersToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" MinWidth="80">
                            <ListBox x:Name="SpeakersList" ItemsSource="{Binding SpeakersOptions}" SelectionChanged="SpeakersList_SelectionChanged" />
                        </Popup>
                        <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows" Margin="0,0,20,0" />
                        <TextBlock Style="{StaticResource Label}" Text="VIDEO" Margin="0,0,6,0" />
                        <ToggleButton AutomationProperties.Name="Video frame rate" x:Name="FpsToggle" Padding="10,3" Foreground="{StaticResource WF.Brush.Blue100}" Background="#332F7BFF"
                                      BorderBrush="{StaticResource WF.Brush.Blue300}" ToolTip="Video frame rate">
                            <TextBlock Text="{Binding Fps, StringFormat={}{0} fps ▾}" FontFamily="{StaticResource WF.Font.Mono}" FontSize="12" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=FpsToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FpsToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" MinWidth="90">
                            <ListBox x:Name="FpsList" ItemsSource="{Binding FpsOptions}" ItemStringFormat="{}{0} fps" SelectionChanged="FpsList_SelectionChanged" />
                        </Popup>
                        <ToggleButton AutomationProperties.Name="Video resolution" x:Name="ResolutionToggle" Padding="10,3" Margin="6,0,0,0" Foreground="{StaticResource WF.Brush.Blue100}" Background="#332F7BFF"
                                      BorderBrush="{StaticResource WF.Brush.Blue300}" ToolTip="Video resolution (16:9 frame, source scaled with aspect ratio kept)">
                            <TextBlock Text="{Binding Resolution, StringFormat={}{0} ▾}" FontFamily="{StaticResource WF.Font.Mono}" FontSize="12" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ResolutionToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ResolutionToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" MinWidth="120">
                            <ListBox x:Name="ResolutionList" ItemsSource="{Binding ResolutionOptions}" SelectionChanged="ResolutionList_SelectionChanged" />
                        </Popup>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
            </StackPanel>
            </TabItem>

            <!-- Transkrypcja dowolnego pliku wideo/audio (te same ustawienia transkrypcji i notatek co dla rozmów) -->
            <TabItem Header="VIDEO FILE">
                <Border x:Name="VideoDrop" AllowDrop="True" Drop="VideoDrop_Drop" DragOver="VideoDrop_DragOver"
                        Background="{StaticResource WF.Brush.Navy700}" BorderBrush="{StaticResource WF.Brush.Blue300}"
                        BorderThickness="1" Padding="16" MinHeight="150">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button AutomationProperties.Name="Choose video or audio file" Style="{StaticResource WF.Button.Primary}" Command="{Binding ImportVideoCommand}" Padding="14,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <controls:WfIcon Kind="plik" Stroke="White" DetailStroke="{StaticResource WF.Brush.Blue100}" />
                                <TextBlock Text="Choose video or audio file..." Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="or drop files here" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource WF.Brush.Slate}" />
                        <TextBlock TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource WF.Brush.Mute}"
                                   Text="Any recording (mp4, mkv, mov, mp3, wav...). Speakers are told apart by voice; transcript, translation and notes follow the settings on the Teams calls tab. The result appears in Recent recordings, the original file stays where it is." />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Wszystko, co zmienia pracę modeli tekstu: zasady notatek, modele, rundy, język, baza wiedzy (słowniczek: TEAMS CALLS) -->
            <TabItem Header="MODELS">
                <Grid Height="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Margin="0,0,8,0">
                        <GroupBox.Header>
                            <TextBlock Text="NOTE RULES  ·  notes-rules.md" ToolTip="Instructions for the models: what each section (conclusions, decisions...) must and must not contain. Sent with every notes request." />
                        </GroupBox.Header>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Style="{StaticResource WF.Button.Primary}" Padding="10,4" Command="{Binding SaveRulesCommand}" Content="Save rules" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource App.Button.Secondary}" Padding="10,4" Margin="0,0,8,0" Command="{Binding OpenRulesCommand}" Content="Open file" />
                            </DockPanel>
                            <TextBox Text="{Binding NotesRules, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource WF.Font.Mono}" FontSize="12" Padding="6,4"
                                     AutomationProperties.Name="Note rules" />
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Margin="0">
                        <GroupBox.Header>
                            <TextBlock Text="TEXT MODELS AND KNOWLEDGE" />
                        </GroupBox.Header>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="WRITER" ToolTip="Ollama model that writes: corrections, notes, translations (e.g. llama3.1:8b)" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CorrectionModel, UpdateSourceTrigger=LostFocus}" Margin="0,2" AutomationProperties.Name="Writer model" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Label}" Text="ROUNDS" Margin="12,2,8,2" ToolTip="Discussion rounds per disputed sentence and note check rounds (1-6)" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding DebateRounds, UpdateSourceTrigger=LostFocus}" Margin="0,2" AutomationProperties.Name="Discussion rounds" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="CHECKER" ToolTip="Ollama model that checks the writer (different family = cross-check; e.g. qwen3.5:4b)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CheckModel, UpdateSourceTrigger=LostFocus}" Margin="0,2" AutomationProperties.Name="Checker model" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Label}" Text="VRAM MB" Margin="12,2,8,2" ToolTip="Memory budget for text models; 0 = whole graphics card. Both fit = both stay loaded (faster)." />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding VramBudgetMb, UpdateSourceTrigger=LostFocus}" Margin="0,2" AutomationProperties.Name="VRAM budget in MB" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="LANGUAGE" ToolTip="Language of the conversation: auto = chosen per channel (PL/EN)" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                    <ToggleButton x:Name="LanguageToggle" AutomationProperties.Name="Conversation language" Padding="10,3" Foreground="{StaticResource WF.Brush.Blue100}" Background="#332F7BFF"
                                                  BorderBrush="{StaticResource WF.Brush.Blue300}">
                                        <TextBlock Text="{Binding TranscriptLanguage, StringFormat={}{0} ▾}" FontFamily="{StaticResource WF.Font.Mono}" FontSize="12" />
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=LanguageToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=LanguageToggle}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" MinWidth="80">
                                        <ListBox x:Name="LanguageList" ItemsSource="{Binding LanguageOptions}" SelectionChanged="LanguageList_SelectionChanged" />
                                    </Popup>
                                </StackPanel>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="KNOWLEDGE BASE  ·  [term - other spelling - meaning], [misheard - =correct]" Margin="0,8,0,4"
                                       TextTrimming="CharacterEllipsis" ToolTip="Explanations the models use to understand terms; one entry per line. Same file as TO CLARIFY saves to." />
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource WF.Button.Primary}" Padding="10,4" Margin="8,0,0,0" Command="{Binding SaveKnowledgeTextCommand}" Content="Save knowledge" />
                                <TextBlock Text="{Binding ModelsStatus}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource WF.Brush.Cyan}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBox Text="{Binding KnowledgeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource WF.Font.Mono}" FontSize="12" Padding="6,4"
                                     AutomationProperties.Name="Knowledge base" />
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
            </TabControl>

            <!-- Ostatnie nagrania -->
            <GroupBox Grid.Row="1">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:WfIcon Kind="plik" />
                        <TextBlock Text="RECORDING" Margin="8,0,0,0" />
                    </StackPanel>
                </GroupBox.Header>
                <DockPanel>
                <!-- Wybór nagrania (lista rozwijana) + co jest teraz analizowane -->
                <DockPanel DockPanel.Dock="Top">
                    <Button AutomationProperties.Name="Transcribe again" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource App.Button.Secondary}" Padding="10,4"
                            Command="{Binding TranscribeCommand}" CommandParameter="{Binding SelectedRecording}"
                            ToolTip="Transcribe the selected recording from scratch (Whisper, speakers, discussion, notes)">
                        <StackPanel Orientation="Horizontal">
                            <controls:WfIcon Kind="plik" />
                            <TextBlock Text="Transcribe again" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Open recording folder" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource App.Button.Secondary}" Padding="10,4"
                            Command="{Binding OpenRecordingCommand}" CommandParameter="{Binding SelectedRecording}" ToolTip="Open the recording folder">
                        <controls:WfIcon Kind="folder" />
                    </Button>
                    <ToggleButton AutomationProperties.Name="Choose a recording" x:Name="RecordingToggle" Padding="10,4" HorizontalContentAlignment="Stretch" Foreground="{StaticResource WF.Brush.Ink}"
                                  Background="{StaticResource WF.Brush.Field}" BorderBrush="{StaticResource WF.Brush.Blue300}" ToolTip="Choose a recording">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="▾" Margin="8,0,0,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedRecording.Details}" Foreground="{StaticResource WF.Brush.Slate}" Margin="16,0,0,0" />
                            <TextBlock Text="{Binding SelectedRecording.Name, FallbackValue='(no recordings)'}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=RecordingToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=RecordingToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=RecordingToggle}">
                        <ListBox x:Name="RecordingList" ItemsSource="{Binding Recordings}" SelectionChanged="RecordingList_SelectionChanged" MaxHeight="320">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Details}" Foreground="{StaticResource WF.Brush.Slate}" Margin="16,0,0,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Popup>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="ANALYZING" />
                    <TextBlock Style="{StaticResource Value}" Foreground="{StaticResource WF.Brush.Warn}" ToolTip="{Binding Analyzing}"
                               Text="{Binding Analyzing, TargetNullValue='-', FallbackValue='-'}" />
                </DockPanel>
                <!-- Objaśnienia: zawsze widoczne (wpis zbiorczy + zapis); lista niejasnych słów wybranego nagrania, gdy jakieś są -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource WF.Button.Primary}" Padding="10,4" Margin="8,0,0,0"
                            Command="{Binding SaveKnowledgeCommand}" ToolTip="Save the explanations to the knowledge base and analyse the selected recording again (discussion, translation, notes)">
                        <TextBlock Text="Save and recalculate" />
                    </Button>
                    <TextBox Text="{Binding BulkKnowledge, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Explanations: [diamentowy golem - jednostka z gry], [konsa - consa - budynek z gry, gdzie zdobywa się anioły]" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="TO CLARIFY" Margin="0,10,0,4"
                           ToolTip="Words the models could not understand in this recording. Explain them once - the knowledge base remembers them for future meetings." />
                <TextBlock DockPanel.Dock="Top" Text="Nothing unclear in this recording." Foreground="{StaticResource WF.Brush.Slate}" FontSize="12"
                           Visibility="{Binding HasNoQuestions, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Term.Term}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Term.Reason}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"
                                           Foreground="{StaticResource WF.Brush.Slate}" ToolTip="{Binding Term.Sentence}">
                                    <Run Text="{Binding Term.Time, Mode=OneWay}" /> <Run Text="{Binding Term.Sentence, Mode=OneWay}" />
                                </TextBlock>
                                <TextBox Grid.Column="2" Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="What it means, e.g. &quot;jednostka z gry&quot;. Other spellings first: &quot;consa - budynek z gry&quot;. Misheard word: &quot;= diamentowy&quot;" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </DockPanel>
            </GroupBox>

            <!-- Log -->
            <TextBox Grid.Row="2" x:Name="LogBox" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" Background="{StaticResource WF.Brush.Navy900}"
                     Padding="10,8" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     FontSize="12" Height="110" TextChanged="LogBox_TextChanged" />

            <!-- Postęp finalizacji -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0" Visibility="{Binding IsFinalizing, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Finalizing recording (MP4 + transcript WAV)..." FontFamily="{StaticResource WF.Font.Mono}" FontSize="11"
                           Foreground="{StaticResource WF.Brush.Slate}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        </Grid>
    </DockPanel>
    </Border>
</Window>
