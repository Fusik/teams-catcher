<Window x:Class="TeamsCatcher.NoteToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Width="400" SizeToContent="Height"
        FontFamily="{StaticResource WF.Font.Body}" FontSize="12" Foreground="{StaticResource WF.Brush.Ink}">
    <!-- Notatka częściowa (kawałek ~5 min) jako powiadomienie przy prawej krawędzi ekranu -->
    <Border Background="{StaticResource WF.Brush.Navy800}" BorderBrush="{StaticResource WF.Brush.Blue500}" BorderThickness="1,1,1,3" Margin="0,0,0,8">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource WF.Brush.Head}" Padding="10,6">
                <DockPanel>
                    <Button AutomationProperties.Name="Close" DockPanel.Dock="Right" Style="{StaticResource App.Button.Caption}" Width="28" Height="22" Click="Close_Click" ToolTip="Close">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource WF.Font.Display}" FontWeight="Bold" Foreground="{StaticResource WF.Brush.Blue100}" />
                        <TextBlock x:Name="RecordingText" FontFamily="{StaticResource WF.Font.Mono}" FontSize="10" Foreground="{StaticResource WF.Brush.Slate}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="10,0,10,8" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource App.Button.Secondary}" Padding="10,3" Click="Open_Click" Content="Open notes" />
            </DockPanel>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="10,8">
                <StackPanel x:Name="Body" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
