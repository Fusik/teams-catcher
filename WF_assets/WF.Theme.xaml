<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App-wide WF look for standard WPF controls (colours from WfTheme roles, so UI Colors applies live).
       Local styles of these types must use BasedOn="{StaticResource {x:Type ...}}" to keep the template. -->

  <!-- Defaults for the derived brushes; BimViewer's WfTheme.Apply replaces them at app level from the base colour / UI Colors -->
  <LinearGradientBrush x:Key="WF.Brush.HeadGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1F305A" Offset="0"/><GradientStop Color="#182547" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="WF.Brush.StripGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#060C1B" Offset="0"/><GradientStop Color="#081024" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="WF.Brush.CaptionActive" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1446A8" Offset="0"/><GradientStop Color="#0D2E6E" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="WF.Brush.Shadow" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="WF.Brush.Secondary" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2E4E86" Offset="0"/><GradientStop Color="#243E6B" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="WF.Brush.Hover" Color="#402F7BFF"/>
  <SolidColorBrush x:Key="WF.Brush.Selection" Color="#1446A8"/>
  <LinearGradientBrush x:Key="WF.Brush.Danger" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A33838" Offset="0"/><GradientStop Color="#802C2C" Offset="1"/></LinearGradientBrush>

  <!-- Button: flat, thin rim, soft gradient; hover lightens and shows the accent rim -->
  <ControlTemplate x:Key="WF.Button.Template" TargetType="{x:Type Button}">
    <Grid>
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
      <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="2" Margin="{TemplateBinding BorderThickness}"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Overlay" Property="Opacity" Value="0.09"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WF.Brush.Blue300}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WF.Brush.Blue500}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Overlay" Property="Background" Value="Black"/>
        <Setter TargetName="Overlay" Property="Opacity" Value="0.18"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource WF.Brush.HeadGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WF.Brush.Rim}"/>
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template" Value="{StaticResource WF.Button.Template}"/>
  </Style>

  <!-- ToggleButton: the Button look; checked = selection fill with an accent rim -->
  <Style TargetType="{x:Type ToggleButton}">
    <Setter Property="Background" Value="{DynamicResource WF.Brush.HeadGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WF.Brush.Rim}"/>
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
            <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="2" Margin="{TemplateBinding BorderThickness}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Overlay" Property="Opacity" Value="0.09"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WF.Brush.Blue300}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WF.Brush.Selection}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WF.Brush.Blue500}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Overlay" Property="Background" Value="Black"/>
              <Setter TargetName="Overlay" Property="Opacity" Value="0.18"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox: dark field, accent arrow, dark drop-down with shadow (the default one is light and ignores dark backgrounds) -->
  <Style x:Key="WF.ComboBox.Toggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Bd" Background="{DynamicResource WF.Brush.Navy800}" BorderBrush="{DynamicResource WF.Brush.Line}" BorderThickness="1" CornerRadius="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
              </Grid.ColumnDefinitions>
              <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource WF.Brush.Blue300}" StrokeThickness="1.6"
                    HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WF.Brush.Blue300}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WF.Brush.Blue500}"/>
              <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource WF.Brush.Cyan}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="6,2,24,2"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton x:Name="Toggle" Style="{StaticResource WF.ComboBox.Toggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <!-- fixed text colour: many ComboBoxes still set Foreground="Black" for the old light template -->
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{DynamicResource WF.Brush.Ink}"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Hidden" Margin="3,1,22,1" Padding="2,0"
                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Focusable="True"
                     Foreground="{DynamicResource WF.Brush.Ink}" CaretBrush="{DynamicResource WF.Brush.Ink}"
                     SelectionBrush="{DynamicResource WF.Brush.Blue500}" IsReadOnly="{TemplateBinding IsReadOnly}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border x:Name="DropDown" Margin="0,1,6,6" SnapsToDevicePixels="True"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource WF.Brush.Navy800}" BorderBrush="{DynamicResource WF.Brush.Rim}" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="300" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="DropDown" Property="MinHeight" Value="24"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Grid>
            <Border x:Name="Bd" Background="Transparent"/>
            <Border x:Name="Mark" Width="2" HorizontalAlignment="Left" Background="Transparent"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WF.Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WF.Brush.Secondary}"/>
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource WF.Brush.Cyan}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TextBox: dark field (the default one is white); the system template still draws the focus / hover rim -->
  <Style TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{DynamicResource WF.Brush.Navy800}"/>
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WF.Brush.Line}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource WF.Brush.Ink}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource WF.Brush.Blue500}"/>
    <Setter Property="Padding" Value="3,2"/>
  </Style>

  <!-- TabControl / TabItem: flat tabs with a separator, accent underline on the selected tab (as in the WF tools) -->
  <Style TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WF.Brush.Line}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
  </Style>

  <Style TargetType="{x:Type TabItem}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Slate}"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WF.Brush.Line}" BorderThickness="0,0,1,0">
              <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Accent" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource WF.Brush.Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Panel.ZIndex" Value="1"/>
              <Setter Property="Background" Value="{DynamicResource WF.Brush.HeadGradient}"/>
              <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Ink}"/>
              <Setter TargetName="Accent" Property="Background" Value="{DynamicResource WF.Brush.Blue500}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ProgressBar: dark track, accent gradient fill, pulsing fill while indeterminate -->
  <Style TargetType="{x:Type ProgressBar}">
    <Setter Property="Background" Value="{DynamicResource WF.Brush.Navy900}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WF.Brush.Line}"/>
    <Setter Property="Foreground" Value="{DynamicResource WF.Brush.Primary}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding Foreground}"/>
            <Border x:Name="Indeterminate" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding Foreground}" Visibility="Collapsed" Opacity="0.35"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Pulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Indeterminate" Storyboard.TargetProperty="Opacity" From="0.15" To="0.75" Duration="0:0:0.8"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Pulse"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
