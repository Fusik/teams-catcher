<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="WF.Colors.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="WF.Button.Primary" TargetType="Button">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontFamily" Value="{StaticResource WF.Font.Display}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="{StaticResource WF.Brush.Primary}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value=".88"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WF.Button.Secondary" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource WF.Brush.Blue100}"/>
    <Setter Property="FontFamily" Value="{StaticResource WF.Font.Body}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#332F7BFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource WF.Brush.Blue300}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="18,10"/>
  </Style>

  <Style x:Key="WF.TextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource WF.Brush.Field}"/>
    <Setter Property="Foreground" Value="{StaticResource WF.Brush.Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WF.Brush.Line}"/>
    <Setter Property="FontFamily" Value="{StaticResource WF.Font.Mono}"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>

  <Style x:Key="WF.DataGridHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource WF.Brush.Head}"/>
    <Setter Property="Foreground" Value="{StaticResource WF.Brush.Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource WF.Font.Mono}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WF.Brush.Blue300}"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>
</ResourceDictionary>
